# Copy to .env and fill in real values. Never commit .env.
PORT=8080
DATABASE_URL=postgres://portfolio:portfolio_dev@localhost:5432/portfolio?sslmode=disable
JWT_SECRET=change-me-to-a-long-random-string
JWT_TTL=24h
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=change-me-8-char-min
ALLOWED_ORIGINS=http://localhost:3000

# Optional — enables image uploads (Supabase Storage)
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=
SUPABASE_BUCKET=

# Optional — enables contact form emails (Resend)
RESEND_API_KEY=
CONTACT_FROM_EMAIL=Portfolio <onboarding@resend.dev>
